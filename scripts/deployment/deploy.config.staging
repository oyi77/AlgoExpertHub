################################################################################
# AlgoExpertHub Deployment Configuration - Staging
################################################################################

# Server Configuration
DEPLOY_SERVER="staging-server-ip"
DEPLOY_USER="root"
DEPLOY_PATH="/opt/algoexpert-staging"
SSH_KEY_PATH="$HOME/.ssh/id_rsa"

# Application Configuration
APP_NAME="AlgoExpertHub-Staging"
APP_URL="https://staging.yourdomain.com"
APP_DEBUG=true
LOG_LEVEL="debug"

# Database Configuration
DB_DATABASE="algoexpert_staging"
DB_USERNAME="algoexpert"
DB_PASSWORD="staging_password"
DB_ROOT_PASSWORD="staging_root_password"

# Redis Configuration
REDIS_PASSWORD="null"

# Pusher/Soketi Configuration
PUSHER_APP_ID="app-id-staging"
PUSHER_APP_KEY="app-key-staging"
PUSHER_APP_SECRET="app-secret-staging"
PUSHER_APP_CLUSTER="mt1"
PUSHER_WS_HOST="socket-staging.yourdomain.com"

# Mail Configuration (use Mailhog for staging)
MAIL_MAILER="smtp"
MAIL_HOST="mailhog"
MAIL_PORT="1025"
MAIL_USERNAME="null"
MAIL_PASSWORD="null"
MAIL_ENCRYPTION="null"
MAIL_FROM_ADDRESS="noreply@staging.yourdomain.com"

# Octane Configuration
OCTANE_HTTPS=false

# Deployment Settings
RUN_MIGRATIONS=true
RUN_SEEDERS=true
AUTO_CONFIRM=false

# Port Configuration
APP_PORT=8000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Application Key
APP_KEY=""
