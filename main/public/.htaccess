# Laravel Static Assets Fix
# This file ensures /build/ assets are served correctly

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization header
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Serve build assets directly (bypass Laravel)
    RewriteCond %{REQUEST_URI} ^/build/ [NC]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^build/(.*)$ public/build/$1 [L]

    # Serve public assets directly
    RewriteCond %{REQUEST_URI} ^/assets/ [NC]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^assets/(.*)$ public/assets/$1 [L]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} /$ 
    RewriteRule ^/(.*)/ /$1 [L=-1]

    # ! - THE RULES IN THIS BLOCK NEED TO BE KEPT IN SYNC WITH public/index.php !
    # If the requested filename exists, serve it.
    # This is the main entry point for the application.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ public/index.php [L]
</IfModule>
