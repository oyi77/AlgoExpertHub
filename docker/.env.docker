# ============================================================================
# AlgoExpertHub Docker Environment Configuration
# ============================================================================
# Copy this file to .env and update the values

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
APP_NAME=AlgoExpertHub
APP_ENV=production
APP_KEY=base64:CHANGEME_GENERATE_WITH_php_artisan_key:generate
APP_DEBUG=false
APP_URL=http://localhost

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=algoexpert
DB_USERNAME=algoexpert
DB_PASSWORD=secret_password_change_me
DB_ROOT_PASSWORD=root_password_change_me

# ----------------------------------------------------------------------------
# Redis
# ----------------------------------------------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ----------------------------------------------------------------------------
# Cache & Queue
# ----------------------------------------------------------------------------
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# ----------------------------------------------------------------------------
# Broadcasting
# ----------------------------------------------------------------------------
BROADCAST_DRIVER=pusher

# ----------------------------------------------------------------------------
# Pusher/Soketi WebSocket
# ----------------------------------------------------------------------------
PUSHER_APP_ID=app-id
PUSHER_APP_KEY=app-key
PUSHER_APP_SECRET=app-secret
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST=soketi
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_WS_HOST=localhost

# For production with reverse proxy:
# PUSHER_WS_HOST=socket.yourdomain.com

# ----------------------------------------------------------------------------
# Soketi
# ----------------------------------------------------------------------------
SOKETI_DEBUG=0
SOKETI_PORT=6001

# ----------------------------------------------------------------------------
# Laravel Octane
# ----------------------------------------------------------------------------
OCTANE_SERVER=swoole
OCTANE_HTTPS=false

# ----------------------------------------------------------------------------
# Laravel Horizon
# ----------------------------------------------------------------------------
HORIZON_NAME=AlgoExpert
HORIZON_PATH=horizon
HORIZON_USE_SYSTEM_SUPERVISOR=true

# ----------------------------------------------------------------------------
# Mail
# ----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@algoexpert.com
MAIL_FROM_NAME="${APP_NAME}"

# For production, use real SMTP:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_ENCRYPTION=tls

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ----------------------------------------------------------------------------
# Docker Container Settings
# ----------------------------------------------------------------------------
# Run migrations on container start
RUN_MIGRATIONS=false

# Run seeders on container start (only for initial setup)
RUN_SEEDERS=false

# ----------------------------------------------------------------------------
# Port Mappings (Host:Container)
# ----------------------------------------------------------------------------
APP_PORT=8000
DB_PORT=3306
REDIS_PORT=6379
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# ----------------------------------------------------------------------------
# External Services (Optional - Configure as needed)
# ----------------------------------------------------------------------------

# OpenAI
OPENAI_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Telegram Bot
TELEGRAM_BOT_TOKEN=

# Payment Gateways
STRIPE_KEY=
STRIPE_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# AWS (for S3 storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
